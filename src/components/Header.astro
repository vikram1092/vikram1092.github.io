---
const links = [
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Résumé', href: '/resume/vikram-ramkumar.pdf', external: true },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Vikram Ramkumar, home">
    <span>Vikram</span>
    <span>Ramkumar</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
            {link.label}
            {link.external && <span aria-hidden="true">↗</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
