---
import BaseLayout from '../layouts/BaseLayout.astro';
const work = [
  { label: 'Skipper AI', href: 'https://www.tryskipper.ai/' },
  { label: 'Cling', href: 'https://www.cling-app.com/' },
  { label: 'The League', href: 'https://www.theleague.com/' },
];
---
<BaseLayout title="Vikram Ramkumar — Engineer, founder, builder"
  description="Vikram Ramkumar builds ambitious products across AI and mobile.">
  <main class="home" id="main">
    <div class="home__photograph" aria-hidden="true"></div>
    <div class="home__still-water" aria-hidden="true"></div>
    <div class="home__canvas" id="water-scene" aria-hidden="true"></div>
    <div class="home__shade" aria-hidden="true"></div>
    <header class="home__header">
      <a class="home__mark" href="/" aria-label="Vikram Ramkumar, home">vr</a>
    </header>
    <section class="home__identity" aria-labelledby="home-title">
      <h1 id="home-title">Vikram<br />Ramkumar.</h1>
    </section>
    <div class="scene-accessibility" hidden>
      <button class="sr-only" id="water-reset" type="button">Reassemble name</button>
      <button class="sr-only" id="water-pause" type="button" aria-pressed="false">Pause animation</button>
    </div>
    <span class="sr-only" id="water-status" aria-live="polite"></span>
    <footer class="home__footer">
      <div class="home__work-group">
        <nav class="home__work" aria-label="Selected work">
          {work.map((item) => <a href={item.href} target="_blank" rel="noreferrer">{item.label}</a>)}
        </nav>
      </div>
      <div class="home__links">
        <a href="/resume/vikram-ramkumar.pdf" target="_blank" rel="noreferrer">Résumé</a>
        <a href="https://www.linkedin.com/in/vikram1092" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="mailto:vik.r92@gmail.com">Contact</a>
      </div>
    </footer>
  </main>
  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      import('../scripts/water-scene')
        .then(({ mountWaterScene }) => mountWaterScene())
        .catch(console.warn)
        .finally(() => {
          // Restore the accessible static view only when startup cannot finish.
          if (!document.querySelector('.home.is-ready')) document.documentElement.dataset.scene = 'fallback';
        });
    }
  </script>
</BaseLayout>
