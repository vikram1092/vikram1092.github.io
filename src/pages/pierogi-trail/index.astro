---
import '../../styles/pierogi-trail.css';
import { CAVES } from '../../scripts/pierogi-trail/model';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#263e3d" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Gallop across Texas, gather pierogi, and find seven famous caverns. Tap anywhere to jump." />
    <title>The Pierogi Trail</title>
    <link rel="icon" href="/pierogi-trail/pierogi.svg" type="image/svg+xml" />
    <link rel="preload" href="/pierogi-trail/art/rider-gallop-v2.webp" as="image" />
  </head>
  <body>
    <main id="stage" aria-label="The Pierogi Trail horseback game">
      <canvas id="trail" tabindex="0" aria-label="Gallop through Texas. Tap anywhere, or press Arrow Up or Space, to jump. P pauses. Tap to resume or replay." aria-describedby="game-instructions">This game needs Canvas and JavaScript enabled.</canvas>
      <div class="trail-hud" aria-label="Ride progress">
        <ol class="cave-route" aria-label="Caves from nearest to farthest from Houston">
          {CAVES.map((cave, i) => <li data-cave={i} aria-label={`${cave.name}, ahead`}><span class="cave-mark" aria-hidden="true"><svg viewBox="0 0 32 25"><path class="mountain" d="M1 24 4 13 9 5 15 1 23 4 29 13 31 24Z" /><path class="opening" d="M10 24v-9l3-5h6l4 5v9" /><path class="stamp" d="m8 13 6 6L26 6" /></svg></span><span class="cave-name">{cave.short}</span></li>)}
        </ol>
        <div class="ride-readout"><span id="region">Webster · NASA neighborhood</span><span class="score"><img src="/pierogi-trail/pierogi.svg" alt="Pierogi" /><span id="score">0</span></span><span id="cave-count">0 / 7</span></div>
        <div class="journey-line" aria-hidden="true"><span id="progress"></span></div>
      </div>
      <audio id="trail-music" src="/pierogi-trail/audio/trail-theme-v1.mp3" preload="auto" loop playsinline hidden></audio>
      <div class="sr-only" id="game-instructions">The horse gallops automatically. Tap anywhere or press Arrow Up, W, or Space to jump. Music and sound effects are always enabled; your first tap starts audio if the browser requires it. P or Escape pauses. Missing an obstacle only causes a brief stumble. Collect pierogi and visit all seven caves. Cave order uses approximate straight-line distance from downtown Houston.</div>
      <div class="sr-only" id="announcement" role="status" aria-live="polite"></div>
      <noscript><p class="fallback">Enable JavaScript to ride the Pierogi Trail.</p></noscript>
    </main>
    <script>import '../../scripts/pierogi-trail/game';</script>
  </body>
</html>
