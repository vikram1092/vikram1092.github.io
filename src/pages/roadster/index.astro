---
import '@fontsource/rajdhani/500.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A midnight Roadster driving experiment." />
    <meta name="theme-color" content="#050810" />
    <title>Roadster · Night Run</title>
    <link rel="icon" type="image/svg+xml" href="/roadster/icon.svg" />
  </head>
  <body>
    <canvas id="roadster" aria-label="Roadster night driving game. Arrow keys drive, Space jumps, F kickflips, Q and E roll, X frontflips, Shift boosts, 1 to 6 change paint, C orbits, R resets, M mutes." tabindex="0"></canvas>
    <div id="speed" aria-label="Speed in miles per hour"><span id="velocity">0</span><small>mph</small></div>
    <script>import '../../scripts/roadster/game';</script>
  </body>
</html>
<style is:global>
  *{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050810;color:#dfe8f6}body{overscroll-behavior:none}canvas#roadster{display:block;width:100%;height:100%;outline:none;cursor:grab}canvas#roadster:active{cursor:grabbing}#speed{position:fixed;right:38px;bottom:27px;display:flex;align-items:baseline;gap:8px;pointer-events:none;font-family:'Rajdhani',sans-serif;font-weight:500;text-shadow:0 0 24px #86a8d444;opacity:.8;font-variant-numeric:tabular-nums}#velocity{font-size:40px;line-height:1;letter-spacing:.025em}#speed small{font-size:12px;letter-spacing:.13em;color:#8e9bab}body[data-driving="true"] canvas{cursor:none}
</style>
