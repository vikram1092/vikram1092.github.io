---
import '@fontsource-variable/manrope';
import '../../styles/bastrop37.css';

const assets = [
  { file: '/bastrop37/assets/bike-blades-turbo-jump.png', title: 'B37 / Rider combat kit', size: 'Approved high-definition concept', description: 'Rear three-quarter bike art showing the core gameplay language: five-foot yellow energy blades, a yellow turbo trail, and the spring jump silhouette.', art: true },
  { file: '/bastrop37/assets/white-ring-drone-concept.png', title: 'White ring drone / encounter kit', size: 'Approved high-definition concept', description: 'The white hovering attacker: ring body, thrusters, attack read, and the visual language for a satisfying split-and-tumble destruction.', art: true },
  { file: '/bastrop37/assets/bike.svg', title: 'B37 / Red motorcycle', size: '32 × 64', description: 'Legacy handling sprite — superseded by the approved concept art above.' },
  { file: '/bastrop37/assets/coupe.svg', title: 'Night coupe', size: '32 × 56', description: 'Current traffic handling sprite.' },
  { file: '/bastrop37/assets/hauler.svg', title: 'Industrial hauler', size: '44 × 84', description: 'Current traffic handling sprite.' },
];
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>BASTROP37 — Asset garage</title></head>
  <body>
    <main class="garage">
      <header class="mast"><a href="/bastrop37/">↙ BACK TO THE CIRCUIT</a><span>BASTROP37 / ASSET GARAGE / 001</span></header>
      <p class="eyebrow" style="margin-top:40px">APPROVED ART + PROTOTYPE KIT</p>
      <h1>ASSET <span>GARAGE</span></h1>
      <p class="garage-copy">The approved high-definition B37 bike and white ring drone are the production direction. The SVGs below are legacy handling placeholders.</p>
      <section class="gallery">
        {assets.map((asset) => (
          <article class="asset">
            <div class="sprite-stage"><img src={asset.file} alt={asset.title} /></div>
            <h2>{asset.title}</h2><p>{asset.size}</p><p>{asset.description}</p>
            <a href={asset.file} target="_blank" rel="noreferrer">{asset.art ? 'OPEN APPROVED ART ↗' : 'OPEN ORIGINAL SPRITE ↗'}</a>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>
