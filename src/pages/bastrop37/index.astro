---
import '@fontsource-variable/manrope';
import '@fontsource/rajdhani/600.css';
import '@fontsource/rajdhani/700.css';
import '../../styles/bastrop37.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#070d13" />
  <meta name="description" content="Ride with Jo through inland Bastrop to deliver the module Mayor Vlad requested." />
  <title>BASTROP37 — Ride through Bastrop</title>
</head>
<body>
<main id="bastrop-game" data-mode="story" data-state="loading">
  <section class="ride" aria-label="Bastrop37 ride">
    <canvas id="game" width="640" height="360" tabindex="0" aria-label="Third-person motorcycle ride. On a phone, hold to accelerate, drag to steer, swipe up to jump and down for spikes. With a keyboard, steer with arrows or WASD. Hold Space to slide. Shift uses turbo. P pauses. Enter advances dialogue.">Your browser needs Canvas to run BASTROP37.</canvas>
    <div id="riding-hud" hidden>
      <div class="distance-remaining" id="distance-remaining" hidden><strong id="distance-value"></strong><span>km left</span></div>
      <div class="guidance" id="guidance" aria-label="Next maneuver">
        <div class="navigation-cue"><span id="turn-arrow" aria-hidden="true">↑</span><span id="next-move"></span></div>
        <p class="gesture-lesson" id="spike-lesson" hidden><span aria-hidden="true">↓</span><span>Swipe down for spikes</span></p>
        <p id="feedback" role="status" aria-live="polite" hidden></p>
        <meter id="task-progress" min="0" max="1" value="0" aria-label="Mission progress" hidden></meter>
        <span id="bus-health" role="meter" aria-label="Bus condition" aria-valuemin="0" aria-valuemax="3" aria-valuenow="3" hidden><span>BUS</span><i></i><i></i><i></i></span>
      </div>
      <div class="velocity" id="velocity" role="meter" aria-label="Speed in kilometers per hour" aria-valuemin="0" aria-valuemax="600" aria-valuenow="0"><strong id="speed">0</strong><span>km/h</span></div>
      <div class="ability-recovery" id="ability-recovery" aria-label="Abilities recharging" hidden><span id="spike-recovery" hidden></span><span id="jump-recovery" hidden></span></div>
      <div class="boost-control">
        <span id="bike-health" role="meter" aria-label="Bike condition" aria-valuemin="0" aria-valuemax="3" aria-valuenow="3" hidden><i></i><i></i><i></i></span>
        <button id="turbo-trigger" type="button" aria-label="Activate turbo" disabled>
          <svg viewBox="0 0 64 64" aria-hidden="true"><circle class="boost-track" cx="32" cy="32" r="29"/><circle id="boost-charge" cx="32" cy="32" r="29" pathLength="100"/><path class="boost-mark" d="M36 14 22 34h10l-4 16 16-23H33z"/></svg>
          <span id="boost-label">BOOST</span>
        </button>
      </div>
    </div>
    <button id="pause" type="button" aria-label="Pause ride" hidden disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg></button>
    <article class="subtitles" id="comms" hidden aria-label="Bike communication">
      <button id="advance" type="button" aria-label="Continue dialogue" aria-describedby="speaker dialogue-text">
        <span id="speaker">MAYOR VLAD</span>
        <span id="dialogue-text"></span>
        <span class="subtitle-next" aria-hidden="true"><span class="advance-key">ENTER</span><span class="advance-tap">TAP TO CONTINUE</span><span class="next-arrow">↗</span></span>
      </button>
    </article>
    <div class="touch-controls" aria-label="Touch riding controls"><div class="dpad"><button type="button" data-key="ArrowLeft" aria-label="Steer left">←</button><div><button type="button" data-key="ArrowUp" aria-label="Accelerate">↑</button><button type="button" data-key="ArrowDown" aria-label="Slow down">↓</button></div><button type="button" data-key="ArrowRight" aria-label="Steer right">→</button></div><div class="actions"><button type="button" data-key="Space">SLIDE</button><button type="button" data-key="ShiftLeft">BOOST</button><button type="button" data-key="ControlLeft">BLADES</button><button type="button" data-key="AltLeft">JUMP</button></div></div>
    <div id="overlay" class="overlay" role="dialog" aria-modal="true" aria-labelledby="headline" tabindex="-1">
      <div class="menu-content">
        <p id="overline">01 / DELIVERY</p>
        <h1 id="headline">BASTROP<span class="title-number">37</span></h1>
        <p id="message">Jo has the module. Mayor Vlad is waiting at municipal intake.</p>
        <p id="save-note" hidden></p>
        <div class="menu-actions">
          <button class="primary" id="start" type="button" disabled>LOADING…</button>
          <button class="primary" id="continue-save" type="button" hidden>CONTINUE RIDE</button>
          <button class="primary" id="resume" type="button" hidden>RESUME RIDE</button>
          <button class="primary" id="continue-chapter" type="button" hidden>CONTINUE TO INTAKE</button>
          <button id="retry" type="button" hidden>RETRY CHECKPOINT</button>
          <button id="new-game" type="button" hidden>START NEW DELIVERY</button>
          <button id="menu" type="button" hidden>MAIN MENU</button>
        </div>
        <div id="reset-confirm" role="group" aria-labelledby="reset-warning" hidden><p id="reset-warning">Start again? This clears saved campaign progress.</p><button id="confirm-new-game" type="button">YES, START OVER</button><button id="cancel-new-game" type="button">CANCEL</button></div>
        <div id="chapter-picker" hidden><p>REPLAY A CHAPTER</p><div class="chapter-options"><button type="button" data-replay-chapter="L1" hidden>01 / DELIVERY</button><button type="button" data-replay-chapter="L2" hidden>02 / BETRAYAL</button><button type="button" data-replay-chapter="L3" hidden>03 / PUBLIC ACCESS</button><button type="button" data-replay-chapter="L4" hidden>04 / LOCKDOWN</button><button type="button" data-replay-chapter="L5" hidden>05 / RELEASE</button></div></div>
        <details id="ride-details" hidden><summary>RIDE STATUS</summary><p id="objective"></p><p id="route-cue"></p><p id="ride-progress"></p><dl><dt>Energy</dt><dd id="charge-value"></dd><dt>Bike</dt><dd id="rider-condition"></dd><dt>Overdrive</dt><dd id="overdrive-state"></dd><dt>Module</dt><dd id="module-state"></dd></dl><p id="replay-badge" hidden>CHAPTER REPLAY</p></details>
        <details id="controls-details"><summary>HOW TO RIDE</summary><div class="control-guide"><p><strong>Phone</strong>Hold the road to accelerate. Release to slow down. Drag to steer. Swipe up to jump, down for spikes. Tap the lightning bolt to boost.</p><p><strong>Keyboard</strong>WASD / arrows to ride · Space + steer to slide · Shift to boost · J / Ctrl for blades · K / Alt to jump · P / Esc to pause · Enter to continue dialogue.</p><p>Brake before tight bends. Boost on exits. Slipstream and close passes recharge boost. The ring fills when boost is ready.</p></div></details>
        <details id="log-details" hidden><summary>TRANSMISSIONS <span id="log-count">0</span></summary><ol id="dialogue-log"></ol></details>
        <footer class="menu-footer"><button id="mute" type="button" aria-label="Mute audio" aria-pressed="false">◉ SOUND</button><a class="site-link" href="/">BACK TO SITE ↗</a></footer>
      </div>
    </div>
  </section>
  <noscript><p class="noscript">Enable JavaScript to ride. You can still browse the <a href="/bastrop37/assets/">asset garage</a>.</p></noscript>
</main>
<script>import { mountGame } from '../../scripts/bastrop37'; mountGame();</script>
</body>
</html>
