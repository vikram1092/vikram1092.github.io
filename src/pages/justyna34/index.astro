---
import '@fontsource-variable/manrope';
import '../../styles/justyna34.css';
import { birthdayRevision, memories } from '../../data/justyna34';

const photoEntries = [
  { memory: memories[memories.length - 1], index: memories.length - 1, clone: true },
  ...memories.map((memory, index) => ({ memory, index, clone: false })),
  { memory: memories[0], index: 0, clone: true },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf9f2" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="happy 34 birthday, Justyna." />
    <title>happy 34 birthday — Justyna</title>
    <link rel="icon" href="/justyna34/birthday.svg" type="image/svg+xml" />
    <link rel="preload" href="/justyna34/fonts/cormorant-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/justyna34/fonts/cormorant-italic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="ambient-light" aria-hidden="true"><div></div><div></div><div></div></div>
    <svg class="svg-defs" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <defs>
        <symbol id="check" viewBox="0 0 24 24"><path d="m5 12 4.5 4.5L19 7" /></symbol>
      </defs>
    </svg>
    <main class="birthday" id="birthday" data-revision={birthdayRevision}>
      <header class="birthday-heading">
        <div class="birthday-balloons" id="birthday-balloons" aria-hidden="true">
          {['left', 'right'].map((side) => (
            <svg class={`balloon-fallback balloon-fallback--${side}`} viewBox="0 0 160 220" fill="none">
              <defs>
                <radialGradient id={`balloon-gold-${side}`} cx="28%" cy="22%" r="80%"><stop stop-color="#f6e6ba" /><stop offset=".35" stop-color="#d9ba7d" /><stop offset="1" stop-color="#a5804c" /></radialGradient>
                <radialGradient id={`balloon-rose-${side}`} cx="28%" cy="22%" r="80%"><stop stop-color="#f8dce1" /><stop offset=".35" stop-color="#d8a0ad" /><stop offset="1" stop-color="#aa737d" /></radialGradient>
                <radialGradient id={`balloon-sage-${side}`} cx="28%" cy="22%" r="80%"><stop stop-color="#e3e8d9" /><stop offset=".35" stop-color="#b1bba3" /><stop offset="1" stop-color="#839078" /></radialGradient>
              </defs>
              <g class="fallback-balloon fallback-balloon--gold">
                <path class="balloon-string" d="M55 103c-15 28 19 51 3 90" />
                <path fill={`url(#balloon-gold-${side})`} d="M55 103C45 94 21 74 21 47 21 2 87 2 89 47 90 73 67 94 55 103Zm0 0-5 8h10Z" />
              </g>
              <g class="fallback-balloon fallback-balloon--rose">
                <path class="balloon-string" d="M109 124c18 25-16 52-6 79" />
                <path fill={`url(#balloon-rose-${side})`} d="M109 124c-13-10-34-30-34-57 0-45 66-45 68 0 1 27-22 48-34 57Zm0 0-5 8h10Z" />
              </g>
              <g class="fallback-balloon fallback-balloon--sage">
                <path class="balloon-string" d="M66 151c-8 25 13 43 7 58" />
                <path fill={`url(#balloon-sage-${side})`} d="M66 151c-10-8-28-25-28-47 0-37 54-37 56 0 0 22-18 40-28 47Zm0 0-4 7h8Z" />
              </g>
            </svg>
          ))}
        </div>
        <h1><span class="title-happy">happy</span> <em class="title-age"><span>34</span></em> <span class="title-birthday">birthday</span></h1>
      </header>

      <section class="album" aria-label="Photos and birthday questions" aria-roledescription="carousel">
        <div class="photo-stage" id="photo-stage" role="group" aria-label="Birthday photos. Swipe, drag, or use the left and right arrow keys to explore.">
          {photoEntries.map(({ memory, index, clone }) => (
            <div class:list={['photo-slot', { 'is-current': index === 0 }]} data-photo-index={index} data-clone={clone ? 'true' : undefined}>
              <div class="photo-drift" style={`--drift-delay: ${-index * 3}s;`}>
                <button class="photo-surface" type="button" tabindex={clone ? '-1' : undefined} aria-label={index === 0 ? 'Enlarge photo 1' : `Show photo ${index + 1}`} style={`--photo-position: ${memory.position ?? '50% 50%'};`}>
                  <span class="photo-window">
                    <img src={memory.photo} alt={memory.alt} width="1100" height="733" loading={index < 2 || clone ? 'eager' : 'lazy'} fetchpriority={index === 0 && !clone ? 'high' : 'auto'} decoding="async" draggable="false" />
                  </span>
                  <span class="photo-light" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          ))}
        </div>

        <div class="question-space">
          {memories.map((memory, index) => (
            <section class="question" id={`question-${index}`} data-question-index={index} aria-labelledby={`question-title-${index}`} hidden={index !== 0}>
              <h2 id={`question-title-${index}`}>{memory.question}</h2>
              <div class="answers" role="group" aria-labelledby={`question-title-${index}`}>
                {memory.options.map((option) => (
                  <button class="answer" type="button" data-option={option.id} aria-pressed="false">
                    <span>{option.label}</span>
                    <svg class="answer-check" viewBox="0 0 24 24" aria-hidden="true"><use href="#check" /></svg>
                  </button>
                ))}
              </div>
            </section>
          ))}
        </div>

      </section>
      <div class="sr-only" role="status" aria-live="polite" id="birthday-status"></div>
    </main>

    <dialog class="photo-dialog" aria-label="Enlarged birthday photo">
      <button class="round-button dialog-close" type="button" aria-label="Close enlarged photo" autofocus><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button>
      <img id="enlarged-photo" alt="" />
    </dialog>
    <script id="birthday-data" type="application/json" set:html={JSON.stringify(memories).replace(/</g, '\\u003c')} />
    <script>
      import '../../scripts/justyna34';
    </script>
  </body>
</html>
