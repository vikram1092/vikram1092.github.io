---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, eyebrow, description, role, period, url, skills, accent } = project.data;
---

<BaseLayout title={`${title} — Vikram Ramkumar`} description={description}>
  <div class={`page-shell project-page project-page--${accent}`}>
    <Header />
    <main id="main">
      <article>
        <header class="project-hero">
          <a class="back-link" href="/#work">← Selected work</a>
          <p class="eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="project-hero__description">{description}</p>
          <dl>
            <div><dt>Role</dt><dd>{role}</dd></div>
            <div><dt>Period</dt><dd>{period}</dd></div>
          </dl>
        </header>
        <div class="project-story">
          <div class="project-story__label"><span>What I built</span></div>
          <div class="prose"><Content /></div>
        </div>
        <div class="project-footer">
          <div class="capability-list">
            {skills.map((skill: string) => <span>{skill}</span>)}
          </div>
          {url && <a class="project-visit" href={url} target="_blank" rel="noreferrer">Visit project <span aria-hidden="true">↗</span></a>}
        </div>
      </article>
    </main>
  </div>
</BaseLayout>
